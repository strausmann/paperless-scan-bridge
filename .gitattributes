# Force LF on all text files so Windows checkouts don't introduce
# CRLF differences. Binary assets are excluded explicitly.

* text=auto eol=lf

# Source files
*.go      text eol=lf
*.sh      text eol=lf
*.bash    text eol=lf
*.py      text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.toml    text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.cfg     text eol=lf
*.ini     text eol=lf
*.conf    text eol=lf
*.rules   text eol=lf
*.service text eol=lf
*.timer   text eol=lf
*.tmpl    text eol=lf
Dockerfile text eol=lf
Makefile  text eol=lf
Tiltfile  text eol=lf

# Binary assets — never touch
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.svg     text eol=lf
*.pdf     binary
*.ico     binary
*.woff    binary
*.woff2   binary
*.ttf     binary

# Linguist hints — don't count vendored docs as project code
docs/**       linguist-documentation
*.md          linguist-documentation
