# Go build artefacts
bin/
dist/
*.test
*.out
coverage.out
coverage.html

# Go module download cache (only if vendored locally)
/vendor/

# Tilt
.tiltbuild/
tilt_modules/

# Docker / compose runtime state
**/docker-data/
**/postgres-data/
**/paperless-data/

# Container volumes that may shadow the host layout during local dev
/var/lib/scan-bridge/
/var/lib/scan-processor/
/var/lib/sane-runtime/

# Decrypted secrets (SOPS leaves these behind on accidents)
*.decrypted
*.decrypted.*
*.key
!*.pub.key
age.key
sops.key

# Local environment overrides
.env
.env.*
!.env.example
!.env.*.example

# Docker Compose file-based secrets (deploy/secrets/*.example are the
# committed CHANGE_ME placeholders; the real files the operator
# copies them to are local-only, never committed)
deploy/secrets/*
!deploy/secrets/*.example

# Deployment profile set (deploy/profiles/*.example are the committed
# templates; the real file compose.yaml mounts carries site-specific
# values such as the Paperless base_url, so it stays local-only — a
# public repository should not learn a private deployment's hosts)
deploy/profiles/*
!deploy/profiles/*.example

# IDE / editor state
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.iml
*.swp
*.swo
.DS_Store
Thumbs.db

# Python (pre-commit cache, ad-hoc venvs)
.venv/
__pycache__/
*.pyc

# Documentation build output
/site/
/public/
docs/.zensical-cache/

# CI / coverage uploads
.codecov.yml.local

# Node tooling (commitlint / semantic-release / prettier)
node_modules/

# Vendored Mermaid bundle (~3.5 MB, fetched by
# .github/scripts/vendor-mermaid.sh, pinned + digest-verified).
# Not committed: it is a reproducible build artifact, not source.
docs/*/javascripts/mermaid.min.js

# Vendored ESP Web Tools bundle (~540 KB, the whole dist/web/ directory
# — it dynamically imports its own per-chip chunks relative to its own
# URL, so it can't be split into a single file the way Mermaid was.
# Fetched by .github/scripts/vendor-esp-web-tools.sh, pinned + digest-
# verified against the npm registry's published integrity hash. Not
# committed: it is a reproducible build artifact, not source.
docs/en/javascripts/esp-web-tools/

# Fetched by .github/scripts/vendor-improv-wifi.sh, pinned + digest-
# verified at build time. Same reason as the esp-web-tools bundle above:
# a build artifact, not source.
docs/en/javascripts/improv-wifi/

# Vendored Scalar standalone bundle (~3.6 MB, single self-contained
# file like Mermaid — fetched by .github/scripts/vendor-scalar.sh,
# pinned + digest-verified against the npm registry's published
# integrity hash for the whole package tarball, English only). Not
# committed: it is a reproducible build artifact, not source.
docs/en/javascripts/scalar/standalone.js

# Copy of components/scan-bridge/api/openapi.yaml (the committed
# source of truth) placed where the docs site can fetch it at
# runtime. Not committed: regenerated by `make docs-vendor`.
docs/en/api-reference/openapi.yaml
