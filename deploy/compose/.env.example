# paperless-scan-bridge — reference stack settings.
#
#   cp .env.example .env && $EDITOR .env
#
# .env is gitignored. Nothing here is a secret: the two tokens live in
# files under secrets/, because an environment variable shows up in
# `docker inspect` and in /proc for anything that can read it.

# ---------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------

# Pins all three images to one release. No `latest` (ADR 0011) --
# compose refuses to start without this rather than defaulting, so an
# unpinned deployment cannot happen by omission.
# Releases: https://github.com/strausmann/paperless-scan-bridge/releases
PSB_VERSION=v1.1.0

# Where the bootstrap script mounted the Synology share. Documents are
# written here; Paperless-ngx consumes from it.
NFS_MOUNT_POINT=/mnt/synology

# ---------------------------------------------------------------------
# Optional — the defaults work
# ---------------------------------------------------------------------

# Host port for the bridge API. The container always listens on 8080.
SCAN_BRIDGE_PORT=18080

# Scratch space for scan-processor. Intermediate TIFFs for one job at
# 600 dpi duplex are the peak; raise it if a large batch fails with
# "no space left on device". It is tmpfs, so this is RAM.
SCAN_PROCESSOR_TMPFS_SIZE=512m

# Config and profiles, relative to this file. The defaults point at
# deploy/config/ and deploy/profiles/, which is where they are already
# versioned -- deploy/profiles/default.yaml is gitignored and yours to
# write:
#   cp ../profiles/default.yaml.example ../profiles/default.yaml
PSB_CONFIG_FILE=../config/config.toml
PSB_PROFILES_FILE=../profiles/default.yaml

# ---------------------------------------------------------------------
# Secrets — paths to files, never the values
# ---------------------------------------------------------------------
#
# Create both before the first `up`:
#
#   printf '%s' 'YOUR_PAPERLESS_TOKEN' > ../secrets/paperless_api_token
#   openssl rand -hex 32               > ../secrets/bridge_token
#   chmod 0640 ../secrets/*
#
# deploy/secrets/ already exists and is gitignored except for the
# *.example files -- which is why the paths below point there rather
# than at a secrets/ directory next to this file that nothing would
# have been ignoring.
#
# 0640, not 0600: the container runs as UID 65532 and cannot read a
# file owned 0600 by your host user. That failure looks like a broken
# upload, not a broken permission -- it has cost this project an
# afternoon once already.
#
# The bridge stores the SHA-256 of bridge_token in its config, never the
# plaintext. The plaintext is what the panel and any other client send.
PAPERLESS_API_TOKEN_FILE=../secrets/paperless_api_token
BRIDGE_TOKEN_FILE=../secrets/bridge_token
