# Phase 1.2 (Task 15) smoke-test profile set for the compose stack in
# compose.yaml.
#
# THIS IS A TEMPLATE. compose.yaml mounts deploy/profiles/default.yaml,
# which is local-only and gitignored -- copy this file to that name and
# fill in your own deployment's values (notably the Paperless base_url
# below). Same convention as deploy/secrets/*.example: the committed
# file carries placeholders, the real one never enters git, so a public
# repository never learns a private deployment's host names.
#
# Schema: components/scan-bridge/internal/profiles/profiles.go
# (validateProfile). "default" is the profile name the morning
# hardware test calls via POST /scan {"profile":"default"}.
#
# source must be one of the three strings sane-runtime's scanapi
# actually accepts (internal/scanapi/handlers.go allowedSources) —
# "ADF Front", "ADF Duplex", or "Flatbed" — NOT a raw SANE device
# string like "avision:libusb:001:004". scan-bridge always sends
# device="" (auto-detect, internal/dispatch/http_client.go) and
# passes profile.Source straight through as sane-runtime's `source`
# field, so a value outside that allow-list is rejected with 400
# invalid_request before the scanner is ever touched. The Kodak
# ScanMate i1120 is a duplex ADF scanner, hence "ADF Duplex" here.
profiles:
  - name: default
    description: "Task 15 hardware smoke test: duplex ADF, color, 300 DPI"
    source: "ADF Duplex"
    resolution: 300
    mode: Color
    format: pdf
    target_subdir: "smoke-test/"
    deskew: true
    remove_blank: true
    rotate_pages: true
    page_size: A4
    timeout_seconds: 120
    metadata_template:
      paperless_tags: ["phase-1.2-smoke-test"]
      paperless_correspondent: null
    # Direct-to-API upload into your Paperless-ngx instance. Replace
    # base_url with your own; the value below is a placeholder and will
    # not resolve. Verified against Paperless-ngx 3.0.5.
    #
    # The API token is NOT here: token_secret names a
    # config.SecretResolver entry, resolved at runtime from the Docker
    # secret mounted at /run/secrets/paperless_api_token (compose.yaml
    # `secrets:`), whose backing file deploy/secrets/paperless_api_token
    # is gitignored.
    #
    # tag_ids are INTEGER Paperless tag IDs, not names — look yours up
    # via GET /api/tags/ on your instance. metadata_template's
    # paperless_tags above are the profile-level string tags; the
    # destination's tag_ids are what actually reaches the Paperless API
    # (internal/api/scan_metadata.go).
    destinations:
      - target: paperless
        storage_first: false
        config:
          base_url: "http://paperless.example.com:8000"
          token_secret: paperless_api_token
          tag_ids: [3]
          tag_strategy: add
