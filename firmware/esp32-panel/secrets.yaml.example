# ESPHome secrets for the CYD scan-control panel firmware
# (cyd-scan-panel.yaml, Issue #9).
#
# Copy this file to `secrets.yaml` in the same directory before running
# `esphome run`/`esphome compile`/`esphome config`. `secrets.yaml` is
# gitignored — never commit it. See README.md for where each value
# comes from.

# Home Wi-Fi network the panel joins for normal operation.
wifi_ssid: "CHANGE_ME"
wifi_password: "CHANGE_ME"

# Fallback SoftAP the panel starts if it cannot join wifi_ssid (first
# boot before Improv provisioning, or a Wi-Fi outage). WPA2 requires at
# least 8 characters.
ap_password: "CHANGE_ME"

# ESPHome native API transport encryption key (32 random bytes,
# base64-encoded). Generate one with:
#   python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
api_encryption_key: "CHANGE_ME"

# Password for OTA firmware updates after the initial USB flash.
ota_password: "CHANGE_ME"

# Bearer token for the scan-bridge HTTP API. Required by POST /scan
# today; also sent on GET /profiles ahead of Issue #9 making that
# endpoint token-gated too. Source: the Vaultwarden item
# "paperless-scan-bridge test token (hhplex01)" — see README.md.
bridge_token: "CHANGE_ME"
